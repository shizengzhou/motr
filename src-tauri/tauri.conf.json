{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Motr",
  "version": "0.1.0",
  "identifier": "com.shizeng.Motr",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Motr",
        "width": 1024,
        "height": 768,
        "minWidth": 478,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "BitTorrent",
        "description": "BitTorrent File",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": ["binaries/aria2c"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/shizengzhou/motr/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3Nzg3MjQzMzYwNTFENDIKUldSQ0hRVTJRM0o0aDk1YjNHdVR6Z0JwdWtmZzVkUnRFQ05lYWUvdEk4bnMxZEQ1RU55REs1Z04K"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["magnet", "thunder", "mo", "motrix"]
      }
    }
  }
}
