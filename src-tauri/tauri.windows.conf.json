{
  "app": {
    "windows": [
      {
        "title": "Motr",
        "width": 1024,
        "height": 768,
        "minWidth": 478,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": ["windows/aria2.conf"],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English",
          "Arabic",
          "Bulgarian",
          "Dutch",
          "Farsi",
          "French",
          "German",
          "Italian",
          "Japanese",
          "Korean",
          "Norwegian",
          "PortugueseBR",
          "Russian",
          "Spanish",
          "Turkish",
          "Ukrainian",
          "Vietnamese"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
